@section Scripts{
@* <link href="~/assets/css/datatables.min.css" rel="stylesheet" />
 <script src="~/assets/js/datatables.min.js"></script>*@
<link href="~/assets/plugins/custom/datatables/datatables.dark.bundle.rtl.css" rel="stylesheet" />
<script src="~/assets/plugins/custom/datatables/datatables.bundle.js"></script>
<script src="~/js/utilities.js"></script>




<script id="personnel-data" type="application/json">
		@Html.Raw(JsonSerializer.Serialize(Model.Personnel))
</script>

<script>
	$(document).ready(function(){

		const table = new DataTable('#kt_table_personnelList', {
			order: [[1, 'asc']],
			columnDefs: [
				{
					targets: 0,
					orderable: false
				},
				{
					targets: 6,
					orderable: false
				}
			],
				// layout: {
				// 	topStart: {
				// 		buttons: ['copy', 'csv', 'excel', 'pdf', 'print']
				// 	}
				// },
			buttons: [
				{
					extend: 'excelHtml5',
					exportOptions: {
						columns: ':not(:last-child)',
						modifier: {
							page: 'all',
							search: 'applied',
							order: 'applied'
						}
					}
				},
				{
					extend: 'print',
					exportOptions: {
						columns: ':not(:last-child)',
						modifier: {
							page: 'all',
							search: 'applied',
							order: 'applied'
						}
					}
				}
			]
		});

		setTimeout(function () {
			$('#table_personnelList').css('visibility', 'visible')
			$('#table_personnelList').hide();
			$('#table_personnelList').fadeIn();
		}, 10)


		$('#mySearch').on('keyup', function() {
			table.search(this.value).draw();
		});

		$('#btnExcel').on('click', function() {
			table.button(0).trigger();
		});

		$('#btnPrint').on('click', function() {
			table.button(1).trigger();
		});
	});



	$(document).on('click', '.personnel-details-link', function(e) {
		e.preventDefault();

		const personnelData = JSON.parse(
			document.getElementById('personnel-data').textContent
		);
	
		const personnelId = Number($(this).data('personnel-id'));

		const personnel = personnelData.find(
			p => p.Id === personnelId
		);

		if (!personnel) {
			return;
		};


		$('#detailFullName').val(personnel.FullName + " / " + personnel.PersonnelCode);
		$('#detailJob').val(personnel.Job);
		$('#detailMembership').val(personnel.Membership);
		$('#detailDepartment').val(personnel.Department ?? '');
		$('#detailAge').val((personnel.BirthDate == null ? '' : " - ") + personnel.Age + " سال");
		$('#detailNationalCode').val(personnel.NationalCode);
		$('#detailFatherName').val(personnel.FatherName);
		$('#detailBirthPlace').val(personnel.PlaceBirth);
		$('#detailGender').val($.convertGenderToFarsi(personnel.Gender));
		$('#detailPlaceOfIssuanceOfBirthCertificate').val(personnel.PlaceOfIssuanceOfBirthCertificate);
		$('#detailEducationalQualification').val($.convertEducationalQualificationToFarsi(personnel.EducationalQualification));
		$('#detailMobileNum').val(personnel.MobileNumber);
		$('#detailEmail').val(personnel.Email);
		$('#detailPhoneNum').val(personnel.PhoneNumber);
		$('#detailPostalCode').val(personnel.PostalCode);
		$('#detailChildrenNum').val(personnel.NumberOfChildren);
		$('#detailManagementLayer').val($.convertManagementLayerToFarsi(personnel.ManagementLayer));
		$('#detailMaritalStatus').val($.convertMaritalStatusToFarsi(personnel.MaritalStatus));
		$('#detailAddress').val(personnel.Address);

	});

</script>
}
