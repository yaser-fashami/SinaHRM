@section Scripts{
<link href="~/assets/plugins/custom/datatables/datatables.dark.bundle.rtl.css" rel="stylesheet" />
<script src="~/assets/plugins/custom/datatables/datatables.bundle.js"></script>
<script src="~/js/utilities.js"></script>

<script id="personnel-data" type="application/json">
		@Html.Raw(JsonSerializer.Serialize(Model.Personnel))
</script>

<script>
	
	$(document).ready(function(){
		const table = new DataTable('#kt_table_personnelList', {
			order: [[1, 'asc']],
			columnDefs: [
				{
					targets: 0,
					orderable: false
				},
				{
					targets: 6,
					orderable: false
				}
			],
			buttons: [
				{
					extend: 'excelHtml5',
					exportOptions: {
						columns: ':not(:last-child)',
						modifier: {
							page: 'all',
							search: 'applied',
							order: 'applied'
						}
					}
				},
				{
					extend: 'print',
					exportOptions: {
						columns: ':not(:last-child)',
						modifier: {
							page: 'all',
							search: 'applied',
							order: 'applied'
						}
					}
				}
			],
		});
		PageLoader.hide();
		setTimeout(function () {
			$('#table_personnelList').css('visibility', 'visible')
			$('#table_personnelList').hide();
			$('#table_personnelList').fadeIn();
		}, 10)


		$('#mySearch').on('keyup', function() {
			table.search(this.value).draw();
		});

		$('#btnExcel').on('click', function() {
			table.button(0).trigger();
		});

		$('#btnPrint').on('click', function() {
			table.button(1).trigger();
		});

		function UnChecked(){
			table.rows({ search: 'applied' })
				.nodes()
				.to$()
				.find('input.form-check-input')
				.prop('checked', false);

			$('#selectAll').prop('checked', false);

		};

		$('#department_sel').on('change', function () {
			UnChecked();
			table.column(4).search(this.value).draw();
		});

		$('#location_sel').on('change', function () {
			UnChecked()
			table.column(2).search(this.value).draw();
		});

		$('#membership_sel').on('change', function () {
			UnChecked()
			table.column(3).search(this.value).draw();
		});

		$('#kt_table_personnelList').on('click', '.start_btn', function () {
			const selectedIds = table.rows().nodes().toArray()
					.filter(row => $(row).find('.form-check-input').is(':checked'))
					.map(row => row.getAttribute('data-personnel-id'));


			if(selectedIds.length == 0){
				const personnelId = $(this)
						.closest('tr')
						.attr('data-personnel-id');

					selectedIds.push(personnelId);
			}
			PageLoader.show('در حال پردازش اطلاعات...');
			$.ajax({
				url: `${window.apiBaseUrl}/api/v1.0/ContractManagement/StartContractProcess`,
				type: 'POST',
				contentType: 'application/json; charset=utf-8',
				data: JSON.stringify(selectedIds),
				success: function(res){
						PageLoader.hide()
						var lines = res.split(/<br\s*\/?>/gi);
						lines.pop();
						lines = lines.reverse();
						toastr.options = {
							"progressBar": true,
							"timeOut": "8000",
						};

						$.each(lines, function(index, line) {
							if(line.includes("<Error/>")){
								toastr.error(line);
							}else{
								toastr.success(line);
							}
						});
						console.log(lines);
				},
				error: function(res){
					PageLoader.hide()
					console.log(res.responseText);
					toastr.error(res.responseText);
				}
			});

			console.log('ردیف‌های انتخاب‌شده:', selectedIds);
		});

		$('#selectAll').on('change', function () {
			const checked = this.checked;
			table.rows({ search: 'applied' })
				.nodes()
				.to$()
				.find('input.form-check-input')
				.prop('checked', checked);
		});
	});


	$('.personnel-details-link').on('click', function (e) {
		e.preventDefault();

		const personnelData = JSON.parse(
			document.getElementById('personnel-data').textContent
		);
	
		const personnelId = Number($(this).data('personnel-id'));

		const personnel = personnelData.find(
			p => p.Id === personnelId
		);

		if (!personnel) {
			return;
		};


		$('#detailFullName').val(personnel.FullName + " / " + personnel.PersonnelCode);
		$('#detailJob').val(personnel.Job);
		$('#detailMembership').val(personnel.Membership);
		$('#detailDepartment').val(personnel.Department ?? '');
		$('#detailAge').val((personnel.BirthDate == null ? '' : " - ") + personnel.Age + " سال");
		$('#detailNationalCode').val(personnel.NationalCode);
		$('#detailBirthCertificateNum').val(personnel.BirthCertificateNumber);
		$('#detailFatherName').val(personnel.FatherName);
		$('#detailBirthPlace').val(personnel.PlaceBirth);
		$('#detailGender').val($.convertGenderToFarsi(personnel.Gender));
		$('#detailPlaceOfIssuanceOfBirthCertificate').val(personnel.PlaceOfIssuanceOfBirthCertificate);
		$('#detailEducationalQualification').val($.convertEducationalQualificationToFarsi(personnel.EducationalQualification));
		$('#detailMobileNum').val(personnel.MobileNumber);
		$('#detailEmail').val(personnel.Email);
		$('#detailPhoneNum').val(personnel.PhoneNumber);
		$('#detailPostalCode').val(personnel.PostalCode);
		$('#detailChildrenNum').val(personnel.NumberOfChildren);
		$('#detailManagementLayer').val($.convertManagementLayerToFarsi(personnel.ManagementLayer));
		$('#detailMaritalStatus').val($.convertMaritalStatusToFarsi(personnel.MaritalStatus));
		$('#detailAddress').val(personnel.Address);

	});


</script>
}
