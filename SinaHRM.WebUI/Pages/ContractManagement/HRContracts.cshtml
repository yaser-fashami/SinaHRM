@section Scripts {
    <link href="~/assets/plugins/custom/datatables/datatables.dark.bundle.rtl.css" rel="stylesheet" />
    <script src="~/assets/plugins/custom/datatables/datatables.bundle.js"></script>

    <script>
        $(document).ready(function() {
            const table = new DataTable('#kt_table_contractList', {
                order: [[1, 'asc']],
                columnDefs: [
                    {
                        targets: 0,
                        orderable: false
                    },
                    {
                        targets: 9,
                        orderable: false
                    },
                    {
                        targets: [6, 7, 8],
                        visible: false,
                        searchable: true
                    }
                ],
                buttons: [
                    {
                        extend: 'excelHtml5',
                        exportOptions: {
                            columns: ':not(:last-child)',
                            modifier: {
                                page: 'all',
                                search: 'applied',
                                order: 'applied'
                            }
                        }
                    },
                    {
                        extend: 'print',
                        exportOptions: {
                            columns: ':not(:last-child)',
                            modifier: {
                                page: 'all',
                                search: 'applied',
                                order: 'applied'
                            }
                        }
                    }
                ],
            });
            PageLoader.hide();
            setTimeout(function() {
                $('#table_contractList').css('visibility', 'visible')
                $('#table_contractList').hide();
                $('#table_contractList').fadeIn();
            }, 10)


            $('#mySearch').on('keyup', function() {
                table.search(this.value).draw();
            });

            $('#btnExcel').on('click', function() {
                table.button(0).trigger();
            });

            $('#btnPrint').on('click', function() {
                table.button(1).trigger();
            });

            $('#selectAll').on('change', function() {
                const checked = this.checked;
                table.rows({ search: 'applied' })
                    .nodes()
                    .to$()
                    .find('input.form-check-input')
                    .prop('checked', checked);
            });

            $('#department_sel').on('change', function() {
                UnChecked();
                table.column(6).search(this.value).draw();
            });

            $('#location_sel').on('change', function() {
                UnChecked();
                table.column(7).search(this.value).draw();
            });

            $('#membership_sel').on('change', function() {
                UnChecked();
                table.column(8).search(this.value).draw();
            });

            function UnChecked() {
                table.rows({ search: 'applied' })
                    .nodes()
                    .to$()
                    .find('input.form-check-input')
                    .prop('checked', false);

                $('#selectAll').prop('checked', false);

            };

        });
    </script>

}