                                        <!--begin::Table-->
                                        <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_contractList">
                                            <!--begin::Table head-->
                                            <thead>
                                                <!--begin::Table row-->
                                                <tr class="text-start text-muted fw-bolder fs-7 text-uppercase gs-0">
                                                    <th class="w-25px">
                                                        <div class="form-check form-check-sm form-check-custom form-check-solid">
                                                            <input id="selectAll" class="form-check-input" type="checkbox" data-kt-check="true" data-kt-check-target="#kt_table_personnelList .form-check-input" value="1">
                                                        </div>
                                                    </th>
                                                    <th class="min-w-200px">شماره قرارداد</th>
                                                    <th class="min-w-200px">همکار</th>
                                                    <th class="min-w-125px">تاریخ شروع</th>
                                                    <th class="min-w-100px">تاریخ پایان</th>
                                                    <th class="min-w-50px">وضعیت قرارداد</th>
                                                    <th class="">دپارتمان</th>
                                                    <th class="">شعبه</th>
                                                    <th class="">عضویت</th>
                                                    <th class="text-end min-w-100px">عملیات</th>
                                                </tr>
                                                <!--end::Table row-->
                                            </thead>
                                            <!--end::Table head-->
                                            <!--begin::Table body-->
                                            <tbody class="text-gray-600 fw-bold">
                                                @if (Model.Contracts is not null)
                                                {
                                                    foreach (var item in Model.Contracts)
                                                    {
                                                        <!--begin::Table row-->
                                                        <tr data-contract-id="@item.Id">
                                                            <!--begin::Checkbox-->
                                                            <td>
                                                                <div class="form-check form-check-sm form-check-custom form-check-solid">
                                                                    <input class="form-check-input" value="1" type="checkbox">
                                                                </div>
                                                            </td>
                                                            <!--end::Checkbox-->
                                                            <!--begin::شماره قرارداد=-->
                                                            <td>@item.ContractNumber</td>
                                                            <!--end::شماره قرارداد=-->
                                                            <!--begin::همکار=-->
                                                            <td>@item.EmployeeFullName</td>
                                                            <!--end::همکار=-->
                                                            <!--begin::تاریخ شروع=-->
                                                            <td>@item.StartDate.ToString("yyyy/MM/dd")</td>
                                                            <!--end::تاریخ شروع=-->
                                                            <!--begin::تاریخ پایان=-->
                                                            <td>@item.EndDate.ToString("yyyy/MM/dd")</td>
                                                            <!--end::تاریخ پایان=-->
                                                            <!--begin::وضعیت قرارداد=-->
                                                            <td>
                                                                @if (new[] { "Draft", "PendingSignature", "Signed" }.Contains(item.Status))
                                                                {
                                                                    <div class="badge badge-light-warning fw-bolder">
                                                                        @FarsiEnums.ConvertContractStatusToFarsi(item.Status.ToString())
                                                                    </div>
                                                                }
                                                                else if (item.Status == "Active")
                                                                {
                                                                    <div class="badge badge-light-success fw-bolder">فعال</div>
                                                                }
                                                                else if (new[] { "Expired", "Cancelled", "Rejected" }.Contains(item.Status))
                                                                {
                                                                    <div class="badge badge-light-danger fw-bolder">
                                                                        @FarsiEnums.ConvertContractStatusToFarsi(item.Status)
                                                                    </div>
