                                            '<span> {{EmploymentContract.SignatureCompleteAtUtc}} </span>'
                                        );
                                    }
                                },
                                {
                                    type: 'menuitem',
                                    text: 'درج حقوق مبنا',
                                    onAction: function(){
                                        editor.insertContent(
                                            '<span> {{Employee.BaseSalary}} </span>'
                                        );
                                    }
                                },
                                {
