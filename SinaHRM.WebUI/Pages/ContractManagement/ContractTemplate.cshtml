@page
@model SinaHRM.WebUI.Pages.ContractManagement.ContractTemplateModel
@{
    ViewData["Title"] = "قالب قراردادهای منابع انسانی";
    ViewData["ActiveLink"] = "contractTemplate";
}
<div class="container-xxl">
    <div class="row my-5">
        <div class="col-3">
            <div class="form-group col-sm">
                <label class="required">انتخاب نوع قرارداد</label>
                <select type="text" class="form-control" id="code">
                    <option value="0" disabled="disabled" selected="selected"></option>
                    <option value="CONTRACT_CENTER">قرارداد تهران</option>
                    <option value="CONTRACT_BANDAR">قرارداد بندری</option>
                </select>
            </div>
        </div>
        <div class="col-9">

        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <textarea id="editor" name="kt_docs_tinymce_basic" class="tox-target col-12">
            </textarea>
        </div>
    </div>
    <div class="row my-5">
        <div class="col-6">
            <div class="form-group col-sm">
                <button id="saveCT_btn" type="button" class="btn btn-primary">ثبت</button>
                <button id="clear_btn" type="button" class="btn btn-secondary">پاک کردن</button>
            </div>
        </div>
        <div class="col-6">
        </div>
    </div>

</div>






