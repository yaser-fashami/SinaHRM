                        }
                    });
                }
            };

            tinymce.init(config);
    
        });    

        $('#saveCT_btn').on('click', function(){
            var text = tinymce.get('editor').getContent();
            var code = $('#code').val();

            if(code != null || code == ''){
                $.ajax({
                    url: `${window.apiBaseUrl}/api/v1.0/contractManagement/saveCT`,
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({ text: text, code: code }),
                    success: function(res){
                        if (res == ''){
                            console.log("SaveContractTemplate succeeded");
                            toastr.success("تغییرات با موفقیت ثبت گردید!");
                        }
                    },
                    error: function(res){
                        console.log(res.responseText);
                    }
                });
            }else{
                return;
            }
        });

        $('#clear_btn').on('click', function(){
            tinymce.get('editor').setContent('');
            $('#code').val(0);
        });

        $('#code').on('change', function(){
            PageLoader.show('در حال دریافت اطلاعات...');
            var code = $('#code').val();

            $.ajax({
                url: `${window.apiBaseUrl}/api/v1.0/contractManagement/GetHRContractTemplate`,
                type: 'GET',
                data: { code: code },
                success: function(res){
                    tinymce.get('editor').setContent(res);
                    PageLoader.hide();
                },
                error: function(){
                    PageLoader.hide();
                }
            });
        });
    
    </script>



}